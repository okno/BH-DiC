# Standalone Mint bridge configuration. Copy outside the repository, chmod 0600,
# and provide an absolute path to `bh-dic bridge-serve --env-file ...`.
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_BIND_PORT=9443
BRIDGE_TLS_CERT_PATH=
BRIDGE_TLS_KEY_PATH=
BRIDGE_CLIENT_CA_PATH=

# codex uses ChatGPT Work through a dedicated CODEX_HOME. Alternatives: ollama, lmstudio.
BRIDGE_BACKEND=codex
BRIDGE_MODEL=workspace-default
BRIDGE_MAX_CONCURRENCY=2
BRIDGE_HR_MEMORY_PATH=

# Required only for BRIDGE_BACKEND=codex. Both directories must be mode 0700,
# owned by the dedicated bridge account, outside its home and outside every Git checkout.
BRIDGE_CODEX_STATE_ROOT=
BRIDGE_CODEX_WORK_ROOT=
# Usually omitted so the pinned openai-codex runtime is used.
BRIDGE_CODEX_EXECUTABLE=

# Required by ollama/lmstudio; it must stay on loopback and use /v1.
BRIDGE_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
