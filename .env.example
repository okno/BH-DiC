# BH-DiC configuration template. Copy to .env, set mode 0600, and fill secrets locally.
# Never commit .env. MOCK_MODE is intended only for isolated tests and local development.

# Application
APP_NAME=BH-DiC
APP_ENV=production
APP_LANGUAGE=it
APP_TIMEZONE=Europe/Rome
MOCK_MODE=false
LOG_LEVEL=INFO
LOG_FORMAT=json
DATA_DIR=./var
DATABASE_URL=sqlite+aiosqlite:///./var/db/bh_dic.sqlite3
AUDIT_HMAC_KEY= # gitleaks:allow -- intentionally empty example value
ENCRYPTION_KEY=

# Closed language/presentation profile. Free-form opening/closing text is local-only.
BOT_LANGUAGE=it
BOT_TONE=professional
BOT_ADDRESS_STYLE=neutral
BOT_VERBOSITY=standard
BOT_EMOJI_MODE=off
BOT_DISPLAY_NAME=
BOT_OPENING=
BOT_CLOSING=

# Discord
DISCORD_BOT_TOKEN= # gitleaks:allow -- intentionally empty example value
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# slash: commands only. channel: route recognized HR messages in DISCORD_CHANNEL_ID and requires
# Message Content Intent plus View/Send/Read Message History permissions.
DISCORD_INTERACTION_MODE=slash
DISCORD_ALLOW_DMS=false
DISCORD_DM_AUTH_GUILD_ID=
DISCORD_DM_ALLOWED_ROLE_IDS=
DISCORD_MENTION_CHANNEL_IDS=
# Sensitive channel results stay private. dm_or_ephemeral attempts an authorized DM and falls
# back to the slash-command ephemeral flow if the user's DMs are closed.
DISCORD_SENSITIVE_DELIVERY_MODE=ephemeral_only
# DIC-derived sensitive answers remain blocked in ordinary channel messages unless this explicit
# opt-in is true and a dedicated human HR_READ role is configured. Use only in a private HR room.
DISCORD_PUBLISH_SENSITIVE_CHANNEL_RESPONSES=false
# For an intentionally guild-wide READ_ONLY baseline, Discord defines @everyone's role ID as
# DISCORD_GUILD_ID. Prefer a dedicated human role for HR_READ and every more privileged mapping.
DISCORD_READONLY_ROLE_IDS=
DISCORD_HR_READ_ROLE_IDS=
DISCORD_PII_ROLE_IDS=
DISCORD_PAYROLL_ROLE_IDS=
DISCORD_DOCUMENT_METADATA_ROLE_IDS=
DISCORD_PROTECTED_DOCUMENT_ROLE_IDS=
DISCORD_BALANCE_ROLE_IDS=
DISCORD_HR_WRITE_ROLE_IDS=
DISCORD_IAM_ROLE_IDS=
DISCORD_DOCUMENT_ROLE_IDS=
DISCORD_APPROVER_ROLE_IDS= # gitleaks:allow -- intentionally empty example value
DISCORD_SECURITY_ADMIN_ROLE_IDS=
DISCORD_SYSTEM_ADMIN_ROLE_IDS=

# Intent model provider. Provider storage must remain disabled.
MODEL_PROVIDER=openai
MODEL_STORE=false
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=1200
MODEL_RESULT_RENDERING=deterministic
MODEL_REASONING_EFFORT=low

# OpenAI (required when MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Groq (required when MODEL_PROVIDER=groq; endpoint is fixed in code)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI-compatible llama endpoint (LLAMA_API_KEY is optional only on loopback)
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=
LLAMA_API_KEY=

# Legacy OPENAI_TIMEOUT_SECONDS, OPENAI_MAX_RETRIES, OPENAI_MAX_OUTPUT_TOKENS,
# OPENAI_REASONING_EFFORT, OPENAI_STORE and OPENAI_RESULT_RENDERING remain accepted
# as aliases. Do not define a legacy and generic setting with different values.

# Dipendenti in Cloud
DIC_BASE_URL=https://secure.dipendentincloud.it
DIC_USERNAME=
DIC_PASSWORD=
DIC_TOTP_SECRET=
DIC_SESSION_ENCRYPTION_KEY=
DIC_EXPECTED_TENANT_ID=
DIC_HEADLESS=true
DIC_LOCALE=it-IT
DIC_TIMEZONE=Europe/Rome
DIC_LOGIN_TIMEOUT_SECONDS=60
DIC_NAVIGATION_TIMEOUT_SECONDS=30
DIC_MAX_CONCURRENT_BROWSER_OPERATIONS=1
DIC_SESSION_STATE_PATH=./var/session/dic_session.enc
DIC_TEST_EMPLOYEE_ID=
DIC_TEST_TENANT_CONFIRMED=false

# Feature flags - every mutating capability is disabled by default.
ENABLE_READ_ACTIONS=true
ENABLE_DIC_RECONNECT=false
ENABLE_WRITE_ACTIONS=false
ENABLE_LIVE_WRITE_TESTS=false
ENABLE_EMPLOYEE_CREATE=false
ENABLE_EMPLOYEE_UPDATE=false
ENABLE_SENSITIVE_PROFILE_UPDATE=false
ENABLE_CONTRACT_WRITE=false
ENABLE_CONTRACT_DELETE=false
ENABLE_MATURATION_WRITE=false
ENABLE_BALANCE_CORRECTION=false
ENABLE_INVITE_ACTIONS=false
ENABLE_ACCOUNT_CONNECT=false
ENABLE_ACCOUNT_DISCONNECT=false
ENABLE_RBAC_WRITE=false
ENABLE_STATUS_CHANGE=false
ENABLE_DOCUMENT_UPLOAD=false
ENABLE_DOCUMENT_DOWNLOAD=false
ENABLE_DOCUMENT_UPDATE=false
ENABLE_DOCUMENT_DELETE=false
ENABLE_EXPORT=false
ENABLE_EMPLOYEE_DELETE=false
REQUIRE_TWO_PERSON_APPROVAL=true
PENDING_ACTION_TTL_MINUTES=10

# File handling
UPLOAD_MAX_MB=20
UPLOAD_RETENTION_HOURS=24
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
CLAMAV_REQUIRED=true
CLAMAV_SOCKET=
SAVE_FAILURE_SCREENSHOTS=false
PLAYWRIGHT_TRACE_MODE=off
TRACE_RETENTION_HOURS=4
EXPORT_MAX_MB=8

# Operations
PID_FILE=./var/run/bh-dic.pid
LOCK_FILE=./var/run/bh-dic.lock
LOG_DIR=./var/log
